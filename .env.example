# --- Mail provider -------------------------------------------------
# One of: agentmail | postmark | cloudflare | console
MAIL_PROVIDER=console
MAIL_AGENT_ADDRESS=review@example.com
# The name on every reply's From line and on the contact card we attach.
MAIL_AGENT_NAME=Second Eye
# One-tap answer links (need plus addressing, review+x@, on the mail domain).
ONE_TAP_LINKS=true
# Other addresses that forward to the agent, if any, so mail to them counts as
# addressed to us rather than as a BCC.
MAIL_AGENT_ALIASES=

AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_SECRET=

# --- Model ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Only if the key above is not scoped to a workspace: the API then refuses
# every request that does not name one. Console > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
REVIEW_MODEL=claude-fable-5-1
# For an Anthropic organisation on zero data retention. Claude Fable 5.1
# requires 30-day retention and refuses a ZDR organisation outright; true puts
# every model call and every agent (applied by `lra agents apply`) on Claude
# Opus 5, the most capable model available under ZDR, whatever REVIEW_MODEL
# and agents/*.yaml say. The cost: Opus 5's judgment instead of Fable's, and no
# refusal fallback. What it does not change: a Managed Agents session's
# container, files and memory stores are still retained (docs/sandbox.md).
ZERO_RETENTION=false
# No TRIAGE_MODEL. There was one, and nothing read it: every call went to
# REVIEW_MODEL. It comes back when the triage path does (DECISIONS, open
# question O18).

# --- Policy --------------------------------------------------------
# Comma-separated addresses/domains allowed to use the agent.
ALLOWED_SENDERS=
# Who to ask to be added, e.g. "Jane Doe" or "jane@firm.com". Named in the
# refusal a colleague gets, so the refusal has a next step.
ALLOWLIST_CONTACT=
# Who may change the firm's playbook by email ("here's our playbook"),
# comma-separated addresses or domains. Empty: the ALLOWLIST_CONTACT address,
# or failing that anyone on FIRM_DOMAINS. See docs/playbook.md.
PLAYBOOK_ADMINS=
# Who a reply may go to (DECISIONS 31). sender_only: the lawyer who sent the
# message and nobody else, enforced where every message leaves, whatever the
# model decided. model: the recipients stand as the model chose them
# (DECISIONS 30). A firm policy, so it is the firm's to change.
REPLY_POLICY=sender_only
# Who decides what an email asks for (docs/migration.md phase 3). rules: the
# phrase lists. shadow: the model triages too, the rules decide, both plans
# are logged in the audit trail. model: the model's plan is carried out. The
# allowlist, the no-AI list and REPLY_POLICY hold in every mode.
TRIAGE=shadow
# Clients whose guidelines exclude AI, comma separated: matter ids, client
# names, or the client's mail domains (e.g. M-1234, Acme, acme.com). A match
# (the matter, a To/CC domain, or a party named in the document) gets no model
# call at all: the deterministic checks, compare, clean copy, renumber and sig
# pages only, and the reply says so. Playbook admins add and lift entries by
# email: "no AI for Acme", "AI ok for Acme". Entries here cannot be lifted by
# email.
NO_AI_MATTERS=
# The legend on every email we send: its last line (small and grey in HTML),
# never its first, which is the verdict a phone previews; and an X-Privileged
# header for the firm's journaling and DLP rules. Empty sends none.
PRIVILEGE_NOTICE=Privileged & Confidential — Attorney Work Product
# The kill switch. true: the edge accepts and silently holds all mail (no
# bounce), and the application reviews nothing and sends nothing. Set it back
# to false and the held mail is released (the daily cron, or at once with
# POST /internal/release on the Worker).
SERVICE_PAUSED=false
# Name on every tracked change and comment the agent writes (e.g. initials).
REDLINE_AUTHOR=Reviewer
# Refuse to process attachments larger than this (MB).
MAX_ATTACHMENT_MB=25
# Delete job rows after N hours. These rows are id, message id, status,
# sender and a rejection reason -- no document bytes are ever written here.
# Document bytes live only in the archive, governed by the ARCHIVE_* settings
# below. 0 or less means keep the rows forever; it does not mean "store
# nothing", which is not achievable while webhook retries have to be
# deduplicated against something. The sweep runs on the inbound path, so no
# cron is needed.
RETENTION_HOURS=24

# `sqlite:///path` for a local file. `d1://` for Cloudflare D1, reached through
# the Worker in cloudflare/: documents then go to R2, and DATA_KEY is required.
DATABASE_URL=sqlite:///./lra.sqlite3

# --- Cloudflare (docs/deploy-cloudflare.md) --------------------------
# The Worker in front of this service, and the one secret that opens its
# internal endpoints. `wrangler deploy` sets both inside the container.
EDGE_URL=
EDGE_SECRET=
# 5 unless every lawyer's address is verified in the Cloudflare account, in
# which case Cloudflare carries 25.
CLOUDFLARE_MAX_MESSAGE_MB=5

# --- Encryption at rest ----------------------------------------------
# 32 random bytes, base64: `lra keygen`. Documents and document-system tokens
# are encrypted with it before they are stored. Whoever holds this key can read
# the firm's documents and nobody else can, so it belongs to the firm. Put the
# old key in DATA_KEY_PREVIOUS when rotating; it is only ever used to read.
DATA_KEY=
DATA_KEY_PREVIOUS=
# Days anything about a document is kept after the conversation's last
# activity: the conversation, its document and versions, a closing and its
# signed pages, unconfirmed notes, and each job's Anthropic sessions. Swept
# daily (src/lra/retention.py). 0 keeps them indefinitely.
THREAD_RETENTION_DAYS=7
# true: learn from undos, dismissals and the sent version without being
# asked, and keep the record of each. false: nothing is learned unless a
# lawyer asks ("remember that", "stop flagging X").
LEARN_FROM_OUTCOMES=false
LOG_LEVEL=INFO

# --- Document management system ------------------------------------
# One of: imanage | netdocuments | sharepoint | none
DMS_PROVIDER=none
DMS_CLIENT_ID=
DMS_CLIENT_SECRET=
DMS_TOKEN_URL=
DMS_AUTHORIZE_URL=
# The MCP Worker's endpoint, ending /mcp. Vault credentials are keyed on it.
DMS_MCP_URL=
# The same value as the MCP Worker's DMS_MCP_SIGNING_KEY secret.
DMS_MCP_SIGNING_KEY=
# query | capability. capability is the fallback if the vault drops the
# session URL's query string; it keeps the token table in use.
DMS_MCP_BINDING=query
DMS_MCP_BINDING_TTL_SECONDS=21600
# Where the OAuth callback lands. Must be reachable by the lawyer's browser.
PUBLIC_BASE_URL=http://localhost:8000

# --- Agent loop ----------------------------------------------------
# Effort on the agent definitions (low | medium | high | xhigh | max). Applied
# by `lra agents apply`, not per request.
AGENT_EFFORT=high
# Wall-clock budget for a review session, in seconds. Past it the session is
# interrupted and the model told to report with what it has, and the reply
# says the review was cut short. Keep it well under the Cloudflare queue
# consumer's fifteen minutes, or a long review is killed rather than cut short.
AGENT_TIME_BUDGET_SECONDS=300
# How long after being told to report the model gets before the session is
# interrupted for good.
AGENT_REPORT_GRACE_SECONDS=90
# Characters of document text sent to the agent in one review. Past this the
# review is scoped and the reply says how far it got.
MAX_REVIEW_CHARACTERS=240000

# The firm's own mail domains, comma separated. Set this whenever the agent
# runs on a subdomain (review@legal.firm.com) while lawyers are @firm.com,
# otherwise every colleague is treated as an outside party.
FIRM_DOMAINS=

# --- Archive -------------------------------------------------------
# Storing privileged client correspondence requires a written policy and the
# firm's sign-off. Read docs/archive.md before switching this on.
ARCHIVE_ENABLED=false
ARCHIVE_BLOBS=true
# Days archived mail is kept, if the archive is on. 0 keeps it indefinitely.
ARCHIVE_RETENTION_DAYS=7

# --- Anthropic Managed Agents ----------------------------------------
# The review and the instruction agent run as Managed Agents sessions in
# Anthropic's cloud sandbox (DECISIONS 28): the document is mounted in the
# container, our tools run there as a skill, and every file that comes back
# is verified locally before it is attached. The container is NOT
# zero-data-retention eligible and keeps files for up to thirty days. Read
# docs/sandbox.md before running anyone else's documents through it.
#
# `lra skills sync` first, then `lra agents apply`, which prints these ids.
# With any of the first three empty nothing model-backed runs.
MANAGED_REVIEW_AGENT_ID=
MANAGED_ASSOCIATE_AGENT_ID=
MANAGED_ENVIRONMENT_ID=
# The playbook agent (agents/playbook.agent.yaml), which reads a firm's
# precedents and memos into position files. Empty: playbook intake by email
# answers that it is not set up, and nothing else changes.
MANAGED_PLAYBOOK_AGENT_ID=
# The comments agent (agents/comments.agent.yaml), printed by `lra agents
# apply`. Empty means "turn the comments" replies that it is not set up.
MANAGED_COMMENTS_AGENT_ID=
# The blackline agent (agents/blackline.agent.yaml), printed by `lra agents
# apply`. With SANDBOX_BLACKLINE_SKILL_ID it answers "blackline" requests with
# the Word comparison, a PDF blackline whose first page is the change summary,
# and a baseline found on the thread ("against v2", "against what we sent on
# Tuesday"). Empty: a blackline request is an ordinary comparison, as before.
MANAGED_BLACKLINE_AGENT_ID=
# Before phase 5 (docs/migration.md) the clientless reviewer had its own id.
# If it is still set, `lra agents apply` adopts that agent as
# MANAGED_REVIEW_AGENT_ID; then delete this line. Nothing else reads it.
MANAGED_REVIEW_DETACHED_AGENT_ID=
# The closing agent (agents/closing.agent.yaml): signature packets across a
# deal's documents, signed pages returned by email, the executed set and the
# closing checklist. Empty: a closing email answers that it is not set up.
MANAGED_CLOSING_AGENT_ID=
# Hard cap on one session's spend, in US cents at list price. 0 for none.
MANAGED_SESSION_BUDGET_CENTS=800
# The firm-wide memory store, created by `lra agents apply`. Per-lawyer and
# per-matter stores are created on first use and recorded in the database.
MANAGED_FIRM_MEMORY_STORE_ID=
# The id `lra skills sync` prints after uploading skills/lra-document-tools:
# the writer, compare, clean and check scripts the agents run in the sandbox.
# Empty means the agents have Anthropic's docx/xlsx/pdf/pptx skills only.
SANDBOX_SKILL_ID=
# The firm's playbook (skills/lra-playbook), from `lra skills sync lra-playbook`.
# Empty means no playbook is consulted.
SANDBOX_PLAYBOOK_SKILL_ID=
# The key-terms skill (skills/lra-key-terms), from `lra skills sync lra-key-terms`.
SANDBOX_KEY_TERMS_SKILL_ID=
# The closing tools (skills/lra-closing), from `lra skills sync lra-closing`.
# Attached to the closing agent only.
SANDBOX_CLOSING_SKILL_ID=
# The comments skill (skills/lra-comments), from `lra skills sync lra-comments`:
# the scripts that read, reply to and resolve comments and accept or reject
# tracked changes. Attached to the comments agent only.
SANDBOX_COMMENTS_SKILL_ID=
# The negotiation ledger (skills/lra-negotiation), from `lra skills sync lra-negotiation`:
# what the other side did with our points, and whether their covering email says so.
SANDBOX_NEGOTIATION_SKILL_ID=
# The blackline skill (skills/lra-blackline), from `lra skills sync lra-blackline`.
# Attached to the blackline agent only.
SANDBOX_BLACKLINE_SKILL_ID=
# Lets the agents search and fetch the web, for checking a party's legal name
# or a cited statute. A query written from a privileged document discloses
# part of it. Applied to the agent definitions by `lra agents apply`.
WEB_SEARCH_ENABLED=false
# "us" or "global". Empty leaves routing to the API's default. Applied to the
# agent definitions by `lra agents apply`.
INFERENCE_GEO=
